        }
      }
    },
    "%@ did not %@ more than a tenth from where it started, so there is no rebound to time. That is a reading about the session, not a gap in the recording.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение показателя «%@» (%@) не превысило 10%, поэтому время восстановления определить нельзя. Это характеристика занятия, а не пробел в записи."
          }
        }
      }
    },
    "%@ each way": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на каждую фазу"
          }
        }
      }
    },
    "%@ held · %@ in total": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ удержано · всего %@"
          }
        }
      }
    },
    "%@ is no longer reachable. Tap Scan to try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь с %@ потеряна. Нажмите «Поиск», чтобы повторить попытку."
          }
        }
      }
    },
    "%@ is your one weak read at %d — %@, while everything else came in at or above normal.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственный слабый показатель — %@ (%d): %@. Остальные не ниже нормы."
          }
        }
      }
    },
    "%@ moved most — %@ versus where you started.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольшее изменение — %@: %@ относительно начала."
          }
        }
      }
    },
    "%@ runs the AI model that writes your guidance. Your metrics — heart-rate variability, breathing rate, session times — are sent to it so the wording can be specific to you.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ обеспечивает работу ИИ, который составляет рекомендации. Ему передаются ваши метрики — вариабельность сердечного ритма, частота дыхания и время сеансов, — чтобы рекомендации учитывали ваши данные."
          }
        }
      }
    },
    "%@ to resting%@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ до уровня покоя%@"
          }
        }
      }
    },
    "%@ vs %@ br/min": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ против %@ дых./мин"
          }
        }
      }
    },
    "%@ was %@ against that average — the clearest departure from your usual.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отклонился от среднего на %@ — самое заметное отличие от обычного уровня."
          }
        }
      }
    },
    "%@ was already back at your resting level when you stopped.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатель «%@» уже вернулся к уровню покоя к концу занятия."
          }
        }
      }
    },
    "%@ was already halfway back when you stopped.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатель «%@» восстановился наполовину уже к концу занятия."
          }
        }
      }
    },
    "%@ was back at your resting level %d min after you stopped — the curve ends there.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатель «%@» вернулся к уровню покоя через %d мин после завершения занятия — на этом график заканчивается."
          }
        }
      }
    },
    "%@ was still short of your resting level %d min after you stopped, so the curve runs to the end of the recording.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатель «%@» ещё не вернулся к уровню покоя через %d мин после завершения занятия, поэтому график продолжается до конца записи."
          }
        }
      }
    },
    "%@ went the other way, %@. One metric drifting is normal; a pattern across sessions is the thing to watch.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ изменился в обратную сторону: %@. Один показатель может колебаться; следите, повторяется ли это в следующих сеансах."
          }
        }
      }
    },
