    "Reduced": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снижено"
          }
        }
      }
    },
    "Reduced arousal · Improved HRV": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше возбуждения · Выше ВСР"
          }
        }
      }
