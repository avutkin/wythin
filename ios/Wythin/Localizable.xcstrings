            "value": "МИН"
          }
        }
      }
    },
    "MIN/DAY": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "мин/день"
          }
        }
      }
    },
    "MIN/MONTH": {
      "localizations": {
