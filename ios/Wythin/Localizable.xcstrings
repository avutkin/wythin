            "value": "5%  допустимо"
          }
        }
      }
    },
    "50  even": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "50  поровну"
          }
        }
      }
    },
    "50  steady": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "50  устойчиво"
          }
        }
      }
    },
    "50  typical": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "50  типичный"
          }
        }
      }
    },
    "54  brake-led": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "54  преобладает замедление"
          }
        }
      }
    },
    "5–15 min": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5–15 мин"
          }
        }
      }
    },
    "6  resonance": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "6  резонанс"
          }
        }
      }
    },
    "6 bpm": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "6 уд/мин"
          }
        }
      }
    },
    "6 months": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "6 месяцев"
          }
        }
      }
    },
    "60 bpm": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "60 уд/мин"
          }
        }
      }
    },
    "60 bpm  resting": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "60 уд/мин  покой"
          }
        }
      }
    },
    "60 bpm: about 1000 ms\n70 bpm: about 860 ms\n80 bpm: about 750 ms\nVery fit (50 bpm): about 1200 ms": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "60 уд/мин: около 1000 мс\n70 уд/мин: около 860 мс\n80 уд/мин: около 750 мс\nОчень хорошая форма (50 уд/мин): около 1200 мс"
          }
        }
      }
    },
    "60,000 divided by the average RR interval (in ms) across the current window, recomputed every ~2 seconds.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "60 000 делится на средний интервал RR в миллисекундах за текущее окно. Значение обновляется примерно каждые две секунды."
          }
        }
      }
    },
    "60–120/min": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "60–120/мин"
          }
        }
      }
    },
    "6M": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "6М"
          }
        }
      }
    },
    "7d ": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 дн. "
          }
        }
      }
    },
    "80 bpm": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "80 уд/мин"
          }
        }
      }
    },
    "80 bpm  moderate": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "80 уд/мин  умеренно"
          }
        }
      }
    },
    "90 sec": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "90 с"
          }
        }
      }
    },
    "90-Second Breathing Reset": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дыхательная пауза на 90 секунд"
          }
        }
      }
    },
    ">%d min, not halfway": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "> %d мин, еще не наполовину"
          }
        }
      }
    },
    "?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "?"
          }
        }
      }
    },
    "A Welch power spectrum of the chest accelerometer's Z axis. The dominant peak in the breathing band is your rate, refined between bins by parabolic interpolation; a peak must clearly rise above the band's average power — otherwise no value is shown rather than a guess.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спектр мощности по Уэлчу для оси Z акселерометра на груди. Основной пик в диапазоне дыхания задаёт частоту; она уточняется интерполяцией. Если пик недостаточно выражен, значение не показывается."
          }
        }
      }
    },
    "A bit about you": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немного о вас"
          }
        }
      }
    },
    "A double in-breath and one long out-breath, repeated. The fastest route down that has been trialled.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двойной вдох и один длинный выдох, повторяемые циклически. Самый быстрый из изученных способов успокоиться."
          }
        }
      }
    },
    "A double in-breath then a long sigh out, which shifts how you feel faster than anything else this short.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двойной вдох и длинный выдох помогают быстро снизить напряжение."
          }
        }
      }
    },
    "A doubled exhale is slow going at first. If the last counts feel forced, shorten the whole cycle rather than breaking the ratio — the ratio is what you are practising.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К удвоенному выдоху нужно привыкнуть. Если последние счеты даются с усилием, сократите весь цикл, сохранив соотношение фаз."
          }
        }
      }
    },
    "A few seconds, five sliders. Tap to answer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять коротких вопросов о самочувствии. Нажмите, чтобы ответить."
          }
        }
      }
    },
    "A few seconds. Skip any you like.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это займёт несколько секунд. Можно пропустить любой пункт."
          }
        }
      }
    },
    "A flat line means an electrode isn't touching your skin. A spiky, maxed-out line means you were moving. Either way, the strap needs attention.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ровная линия означает отсутствие контакта электрода с кожей. Резкие пики на пределе шкалы указывают на движение. В обоих случаях проверьте ремень."
          }
        }
      }
    },
    "A great live signal while breathing: watch the gap stretch on each exhale and shrink on each inhale. Big, smooth waves mean you've found your rhythm.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наблюдайте за интервалом во время дыхания: на выдохе он удлиняется, на вдохе сокращается. Плавные большие волны помогают найти ритм."
          }
        }
      }
    },
    "A healthy heart is lopsided on purpose — decelerations tend to carry slightly more than half the variance. The asymmetry appears to come from the vagus acting faster than sympathetic drive can. Losing it, and drifting toward a flat 50, is the pattern seen with age and with illness.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здоровому сердцу свойственна небольшая асимметрия — замедления обычно дают чуть больше половины изменчивости. Возможно, это связано с более быстрым действием блуждающего нерва. Смещение к ровным 50 наблюдается с возрастом и при болезнях."
          }
        }
      }
    },
    "A healthy heartbeat isn't perfectly regular — it has layered, ever-shifting patterns. This measures how much of that healthy complexity is present.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здоровый ритм не бывает идеально ровным: в нём есть слои меняющихся закономерностей. Показатель оценивает эту сложность."
          }
        }
      }
    },
    "A higher number means your 'brakes' are strong: you handle stress better, recover faster, and tend to sleep and feel better. A low number is a nudge to rest and downshift.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более высокое значение указывает на активную систему успокоения, которая помогает справляться со стрессом и восстанавливаться. Низкое значение подсказывает снизить нагрузку."
          }
        }
      }
    },
    "A hold also brings on the diving response — the heart slows and the spleen squeezes a reserve of red cells into circulation — and repeating it is the stimulus the adaptations are built on.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка также вызывает рефлекс погружения: сердце замедляется, а селезенка выбрасывает в кровь запас эритроцитов. Повторение служит стимулом для адаптации."
          }
        }
      }
    },
    "A hold also triggers the diving response — the heart slows and the spleen squeezes a reserve of red cells into circulation. Repeating it is the stimulus the adaptations are built on.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка также вызывает рефлекс погружения: сердце замедляется, а селезенка выбрасывает в кровь запас эритроцитов. Повторение служит стимулом для адаптации."
          }
        }
      }
    },
    "A large inflation loads the stretch receptors in the lungs and the slow exhale that follows unloads them. That rise-and-release is a strong version of the swing every slow breath makes, which is why the exhale here is the part to take your time over.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При глубоком вдохе активируются рецепторы растяжения в легких, а медленный выдох снимает нагрузку. Это усиленная версия колебания, которое возникает при каждом медленном дыхательном цикле. Поэтому не торопитесь с выдохом."
          }
        }
      }
    },
    "A moderate amount is completely normal. High choppiness points to a nervous system that isn't coordinating smoothly — often from stress, poor sleep, or being run-down.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Умеренная фрагментация нормальна. Высокая может говорить о нарушенной согласованности нервной регуляции, в том числе из-за стресса, недосыпа или усталости."
          }
        }
      }
    },
    "A month-long randomised trial of three breathwork practices against mindfulness. Box breathing improved mood and lowered anxiety — though exhale-focused breathing improved mood more.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В месячном рандомизированном исследовании сравнили три дыхательные практики с медитацией осознанности. Квадратное дыхание улучшало настроение и снижало тревожность, хотя дыхание с акцентом на выдох улучшало настроение сильнее."
          }
        }
      }
    },
    "A name is letters only — at least two of them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя и фамилия должны содержать не менее двух букв."
          }
        }
      }
    },
    "A narrowed airway or a closed nostril. The resistance is the intervention; the rate follows from it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суженные дыхательные пути или закрытая ноздря. Основное действие дает сопротивление; частота меняется вслед за ним."
          }
        }
      }
    },
    "A nice, noise-resistant companion to your other calm metrics. It should rise during slow-breathing sessions and improve over weeks of practice.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устойчивое к шуму дополнение к другим метрикам спокойствия. Должен расти во время медленного дыхания и постепенно улучшаться с практикой."
          }
        }
      }
    },
    "A phone number needs at least seven digits.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В номере телефона должно быть не менее семи цифр."
          }
        }
      }
    },
    "A rising CO₂ is also what makes this one to approach carefully. Air hunger is the sensation, and for some people it is the trigger rather than the remedy — if the hold brings on alarm rather than settling, stop and use an even breath instead.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рост CO₂ требует осторожности. Нехватка воздуха у некоторых вызывает тревогу вместо облегчения. Если задержка пугает, остановитесь и перейдите к ровному дыханию."
          }
        }
      }
    },
    "A second signal-quality check that looks at the raw heartbeat waveform itself. 0% is clean; 100% means the strap has lost contact with your skin.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительная проверка качества по форме ЭКГ. 0% — чистый сигнал, 100% — датчик потерял контакт с кожей."
          }
        }
      }
    },
    "A seven-count hold on a full breath. CO₂ accumulation is a recognised panic-provocation model, so this stays outside the measured comparison set.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка на семь счетов после вдоха. Накопление CO₂ используют в исследованиях для вызова паники, поэтому эта практика остается в разделе с наблюдением инструктора."
          }
        }
      }
    },
    "A short guided breathing cycle to activate your parasympathetic nervous system and lower arousal.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий сеанс дыхания с сопровождением помогает активировать парасимпатическую систему и снизить возбуждение."
          }
        }
      }
    },
    "A short walk": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткая прогулка"
          }
        }
      }
    },
    "A short, firm inhale, then a forceful exhale against a braced trunk — the sound is a sharp \"hook\". Two or three of them, fifteen to thirty seconds in total, and then you go back to breathing normally. It is a move, not a session.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротко и энергично вдохните, затем с силой выдохните, напрягая мышцы корпуса: должен получиться резкий звук «хук». Повторите два-три раза. Вся процедура занимает пятнадцать-тридцать секунд, после чего вернитесь к обычному дыханию. Это краткий прием, а не сеанс."
          }
        }
      }
    },
    "A simple 0–100 stress dial: higher means more revved-up and alert, lower means calmer. It's built so that slow, calming breathing actually reads as calmer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Простая шкала стресса от 0 до 100: выше — больше возбуждения, ниже — спокойнее. Она устроена так, чтобы медленное дыхание правильно отражалось как успокоение."
          }
        }
      }
    },
    "A single big artifact inflates it more than any other metric here, since one wrong interval enters the sum squared. Trust it most where the Signal Artifacts chart below is low.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже один крупный артефакт может сильно завысить значение. Доверяйте метрике, когда доля артефактов сигнала мала."
          }
        }
      }
    },
    "A slow, background rhythm in your heartbeat that plays out over minutes. It reflects deep, long-running regulation rather than anything you feel moment to moment.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленный фоновый ритм сердца с периодом в несколько минут. Он отражает длительную регуляцию, а не мгновенные ощущения."
          }
        }
      }
    },
    "A strong brake means you bounce back faster after stress, fall asleep more easily, and stay calmer under pressure. A weak one is a sign you're stuck in 'go mode' too often.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильное торможение помогает быстрее восстановиться после стресса и легче успокоиться. Слабое может указывать на длительное состояние напряжения."
          }
        }
      }
    },
    "A wide spread means your nervous system has room to move: it speeds up, slows down, and responds to what the day asks of it. A narrow one means something is holding the heart to a fixed rhythm — stress, illness, alcohol, or hard training you haven't recovered from.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Широкий разброс означает, что нервная система умеет ускоряться, замедляться и реагировать на события. Узкий может быть связан со стрессом, болезнью, алкоголем или ещё не восстановленной тяжёлой нагрузкой."
          }
        }
      }
    },
    "ABOUT": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О ПРИЛОЖЕНИИ"
          }
        }
      }
    },
    "ACC Z — BREATHING": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ДЫХАНИЕ · ОСЬ Z"
          }
        }
      }
    },
    "ACCESS TOKEN": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ТОКЕН ДОСТУПА"
          }
        }
      }
    },
    "ACTIVE": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "АКТИВНО"
          }
        }
      }
    },
    "ACTIVITIES": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "АКТИВНОСТИ"
          }
        }
      }
    },
    "AFT": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПОСЛЕ"
          }
        }
      }
    },
    "AFT — 10 min after": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПОСЛЕ — через 10 мин"
          }
        }
      }
    },
    "AFTER": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПОСЛЕ"
          }
        }
      }
    },
    "AGE": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВОЗРАСТ"
          }
        }
      }
    },
    "AI guidance is off, so this night has not been read. Turn it on in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказки ИИ выключены, поэтому эта ночь не была проанализирована. Включите их в настройках."
          }
        }
      }
    },
    "ALL THE WAY IN": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВДОХНИТЕ ПОЛНОСТЬЮ"
          }
        }
      }
    },
    "ALL THE WAY OUT": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВЫДОХНИТЕ ПОЛНОСТЬЮ"
          }
        }
      }
    },
    "ANXIETY": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ТРЕВОЖНОСТЬ"
          }
        }
      }
    },
    "ASLEEP": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СПАЛИ"
          }
        }
      }
    },
    "AT": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В"
          }
        }
      }
    },
    "AUTONOMIC BALANCE": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВЕГЕТАТИВНЫЙ БАЛАНС"
          }
        }
      }
    },
    "AUTONOMIC COST": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВЕГЕТАТИВНЫЕ ЗАТРАТЫ"
          }
        }
      }
    },
    "AVERAGE": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СРЕДНЕЕ"
          }
        }
      }
    },
    "About six cycles a minute, no holds: the breath meets the slow wave already running in your blood pressure.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около шести циклов в минуту без задержек: дыхание совпадает с медленной волной артериального давления."
          }
        }
      }
    },
    "About the recording, not your body. A small repaired share is routine; a large one means the metrics are leaning on reconstructed beats.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатель описывает запись, а не организм. Небольшая доля исправлений обычна; большая означает, что метрики сильно зависят от восстановленных данных."
          }
        }
      }
    },
    "Absorbing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Погружение"
          }
        }
      }
    },
    "Acceleration Capacity (AC)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потенциал ускорения (AC)"
          }
        }
      }
    },
    "Acceleration is the vagal brake easing off, plus sympathetic drive on top. A system with range has both a strong brake and a strong throttle. A throttle that is strong while the brake is weak is the signature of a body stuck in go-mode; both weak means range has gone altogether.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ускорение складывается из ослабления вагусного торможения и симпатической активации. Гибкой системе нужны и сильный «тормоз», и сильный «ускоритель». Сильное ускорение при слабом торможении может означать постоянную активацию; слабость обоих — ограниченный диапазон реакций."
          }
        }
      }
    },
    "Access token": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен доступа"
          }
        }
      }
    },
    "Across the literature, breathing under about ten a minute shifts autonomic balance toward the parasympathetic side and is associated with reduced anxiety.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласно исследованиям, дыхание реже примерно десяти раз в минуту смещает вегетативный баланс в сторону парасимпатической системы и связано со снижением тревожности."
          }
        }
      }
    },
    "Activation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активация"
          }
        }
      }
    },
    "Activation Breath": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бодрящее дыхание"
          }
        }
      }
    },
    "Active sleep": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активный сон"
          }
        }
      }
    },
    "Activities": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занятия"
          }
        }
      }
    },
    "Acute Anxiety": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Острая тревога"
          }
        }
      }
    },
    "Adaptive Capacity": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптивность"
          }
        }
      }
    },
    "Adaptive Capacity (Refined Composite Multiscale Entropy) reflects how flexible your system is across timescales. A gradual rise over days suggests your system is adapting well to your routine; a steady decline can signal accumulating strain.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптивность (уточнённая составная многомасштабная энтропия) показывает гибкость организма на разных временных масштабах. Постепенный рост говорит о хорошем приспособлении к режиму; устойчивое снижение может указывать на накопление нагрузки."
          }
        }
      }
    },
    "Adaptive Capacity (Refined Composite Multiscale Entropy) reflects how flexible your system is across timescales. Higher signals a resilient, responsive heart; expect a modest rise with calm focus.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптивность (уточненная составная многомасштабная энтропия) отражает гибкость сердечного ритма на разных временных масштабах. Более высокое значение означает устойчивую и отзывчивую систему. При спокойной концентрации обычно немного растет."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сложно"
          }
        }
      }
    },
    "After A Spike": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После всплеска стресса"
          }
        }
      }
    },
    "After each beat your heart muscle has to recharge before it can beat again. That recharge takes a few tenths of a second, and it should take about the same time every beat. This measures how much that time drifts.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После каждого удара сердечная мышца должна электрически восстановиться. Это занимает доли секунды и обычно длится примерно одинаково. Метрика измеряет колебания этой длительности."
          }
        }
      }
    },
    "Against your need": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнение с потребностью"
          }
        }
      }
    },
    "Aim for an exhale about 1.5–2× your inhale. Try 4 seconds in and 6 out (that's 1.5), or 4 in and 8 out (that's 2.0). Ease into it — don't strain for a long exhale.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стремитесь к выдоху в 1,5–2 раза длиннее вдоха. Попробуйте вдох на 4 секунды и выдох на 6 или 8. Удлиняйте выдох без усилия."
          }
        }
      }
    },
    "Airway Resistance": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сопротивление дыхательных путей"
          }
        }
      }
    },
    "Albert Einstein": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Альберт Эйнштейн"
          }
        }
      }
    },
    "Alcohol": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Алкоголь"
          }
        }
      }
    },
    "Alert Calm": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойная бодрость"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все"
          }
        }
      }
    },
    "All four are required to finish.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполните все четыре поля."
          }
        }
      }
    },
    "Allow Bluetooth in iPhone Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Bluetooth в настройках iPhone"
          }
        }
      }
    },
    "Allow notifications": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить уведомления"
          }
        }
      }
    },
    "Almost all of this sat below threshold. If it was meant to be easy, that is exactly right — if not, there is room to push.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти всё занятие прошло ниже порога. Если вы планировали лёгкую нагрузку — это верно; если нет, можно немного повысить интенсивность."
          }
        }
      }
    },
    "Almost everything settled together, which is what a practice landing properly looks like. Worth remembering what the conditions were.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти все показатели улучшились одновременно — практика подействовала. Стоит запомнить условия, при которых это произошло."
          }
        }
      }
    },
    "Alternate Nostril": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попеременное дыхание ноздрями"
          }
        }
      }
    },
    "An even breath in and out with nothing held at either end, at the classic five-and-a-half-second cadence — about five and a half breaths a minute. Set the pace in seconds a side, anywhere from three to eight, in halves. The ring shows the whole cycle and the beat keeps you on it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ровные вдох и выдох без задержек в классическом ритме по пять с половиной секунд: примерно пять с половиной циклов в минуту. Длительность каждой фазы можно настроить от трех до восьми секунд с шагом полсекунды. Круг показывает весь цикл, а звуковой сигнал помогает держать ритм."
          }
        }
      }
    },
    "An even four-part breath used by people who need to stay level under load. A metronome counts each beat so you can keep the rhythm with your eyes closed, and the box on screen shows exactly where you are in the cycle. Set the time, pace and tempo at the bottom of the session.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ровный ритм из четырех фаз помогает сохранять самообладание при нагрузке. Метроном отсчитывает удары, поэтому можно дышать с закрытыми глазами. Квадрат на экране показывает текущую фазу. Длительность, ритм и темп настраиваются внизу экрана сеанса."
          }
        }
      }
    },
    "An old-school 'stress ratio' isn't shown here because it misleads during breathwork — this dial is the app's stress signal.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежняя шкала «соотношения стресса» здесь не показана: она вводит в заблуждение во время дыхательных практик."
          }
        }
      }
    },
    "Anapanasati": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анапанасати"
          }
        }
      }
    },
    "Andrew Weil": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эндрю Вейл"
          }
        }
      }
    },
    "Anxiety": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тревожность"
          }
        }
      }
    },
    "Anything you use to track performance or state.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите устройства, которыми пользуетесь."
          }
        }
      }
    },
    "Apple Watch": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch"
          }
        }
      }
    },
    "Archive full Polar signal": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять полный сигнал Polar"
          }
        }
      }
    },
    "Archive full signal in cloud": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять полный сигнал в облаке"
          }
        }
      }
    },
    "Archive the full Polar signal?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять полный сигнал Polar?"
          }
        }
      }
    },
    "Arousal Regulation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регуляция возбуждения"
          }
        }
      }
    },
    "Arrives in 5 seconds — background the app to see the real banner and its buttons.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Придёт через 5 секунд. Сверните приложение, чтобы увидеть уведомление и его кнопки."
          }
        }
      }
    },
    "At most three a day, never between 10pm and 7am, and never while you're moving.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не более трёх раз в день, только с 07:00 до 22:00 и когда вы не двигаетесь."
          }
        }
      }
    },
    "Attention": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внимание"
          }
        }
      }
    },
    "Attention rests on the breath where you feel it most clearly — at the nostrils, or in the belly — and the breath is left entirely alone. Long or short, rough or smooth, you note it and let it be. There is no pacer here and there is not meant to be: the instant you start steering the breath, this becomes a different practice.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сосредоточьтесь на дыхании там, где оно ощущается отчетливее: у ноздрей или в животе. Не меняйте его. Длинное или короткое, ровное или неровное — замечайте и оставляйте как есть. Здесь нет подсказчика ритма: как только вы начинаете управлять дыханием, практика становится другой."
          }
        }
      }
    },
    "Autonomic": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вегетативная регуляция"
          }
        }
      }
    },
    "Autonomic cost": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вегетативные затраты"
          }
        }
      }
    },
    "Autonomic transition — extend rest": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нервная система перестраивается — продлите отдых"
          }
        }
      }
    },
    "Average improvement %+.0f%% across both phases — full marks is +%.0f%% on a metric.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среднее улучшение по двум фазам: %+.0f%%. Максимальная оценка достигается при +%.0f%% для каждого показателя."
          }
        }
      }
    },
    "Awake": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бодрствование"
          }
        }
      }
    },
    "B.K.S. Iyengar": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Б. К. С. Айенгар"
          }
        }
      }
    },
    "BASELINE": {
      "localizations": {
