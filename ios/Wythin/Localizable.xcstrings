    },
    "Recovery": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление"
          }
        }
      }
    },
    "Recovery Move": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прием для восстановления"
          }
        }
      }
    },
    "Recovery is read from several checkpoints arriving over the hour after you stop. One on its own is a reading, not a score — so the measurements are below and the number waits.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для оценки восстановления нужны несколько измерений в течение часа после остановки. Одно измерение дает только отдельное значение, поэтому данные уже показаны ниже, а итоговая оценка появится позже."
          }
        }
      }
    },
    "Reduce Anxiety": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снизить тревожность"
          }
        }
      }
    },
    "Reduce anxiety": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снизить тревожность"
          }
        }
      }
