          }
        }
      }
    },
    "Resonance Breathing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резонансное дыхание"
          }
        }
      }
    },
    "Resonance: around 6 br/min\nRestful:   6–12 br/min\nTypical:   12–16 br/min\nFast:      20+ br/min": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резонанс: около 6 дых./мин\nСпокойно: 6–12 дых./мин\nОбычно: 12–16 дых./мин\nЧасто: от 20 дых./мин"
          }
        }
      }
    },
    "Respiratory Sinus Arrhythmia (RSA)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дыхательная синусовая аритмия (RSA)"
          }
        }
      }
    },
    "Responsive — moves quickly with your breathing and with sudden stress.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро реагирует на дыхание и внезапный стресс."
          }
        }
      }
    },
