          "stringUnit": {
            "state": "translated",
            "value": "ИСХОДНЫЙ УРОВЕНЬ"
          }
        }
      }
    },
    "BATTERY BELOW 5%": {
      "localizations": {
        "ru": {
          "stringUnit": {
